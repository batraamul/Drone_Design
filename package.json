{
  "name": "aerolab-x",
  "version": "0.6.0",
  "private": true,
  "description": "AEROLAB X \u2014 Drone Design, Intelligence & Simulation Studio. A local-first engineering workstation for civilian UAVs and micro aerial vehicles.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs --root . --port 8080",
    "serve:site": "node scripts/serve.mjs --root _site --port 4173 --base /Drone_Design/",
    "check": "node scripts/check-structure.mjs",
    "build": "node scripts/build-site.mjs",
    "test:unit": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "fake-indexeddb": "6.2.8"
  },
  "license": "Apache-2.0"
}
